<idea-plugin>
    <id>io.github.koollsl.intellij-lsl</id>
    <name>LSL &amp; SLua for Second Life</name>
    <version>GENERATED-BY_build.gradle.kts</version>

    <vendor url="https://github.com/KoolLSL/intellij-lsl">KoolLSL</vendor>

    <description><![CDATA[
<p>Write <strong>LSL</strong> (Linden Scripting Language) and <strong>SLua</strong> (Server Lua) for <em>Second Life</em> directly inside IntelliJ IDEA, PyCharm, Android Studio, and other JetBrains editors across Windows, macOS, and Linux.</p>

<h3>Key Features</h3>
<ul>
  <li><strong>Project &amp; File Organization:</strong> Manage large multi-file projects using structured project views, shared library, local history, file comparison, GitHub integration, and more.</li>
  <li><strong>Up-to-date language definitions:</strong> LSL functions, constants, and events, along with SLua definitions and documentation, come from the official <a href="https://github.com/secondlife/lsl-definitions">Second Life language definitions</a> project. The plugin checks for updates or can use a custom definitions folder instead.</li>
  <li><strong>Code Formatting &amp; Clean Up:</strong> Automatically format your code, fix indentation, and keep your scripts clean and readable.</li>
  <li><strong>Smart Scripting Tools:</strong> Instant syntax highlighting, real-time error checking, smart auto-completion, and safe variable/function refactoring.</li>
  <li><strong>Advanced Preprocessor (LSL only):</strong> Use file inclusions (<code>#include</code>), function inlining (<code>#inline</code>), and conditional blocks (<code>#ifdef</code>...) to organize large script projects. SLua uses a module system instead.</li>
  <li><strong>Memory Optimization (LSL only):</strong> Before compiling, built-in constant optimization evaluates static math, replaces fixed variables, and eliminates dead code to help keep scripts within LSL's memory limits. SLua has its own methods.</li>
</ul>

<p>Second Life® and SL™ are registered trademarks of Linden Research, Inc. This plugin is an independent third-party tool and is not affiliated with, sponsored by, or endorsed by Linden Research, Inc.</p>
]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!-- Register resource bundle for UI localizations -->
    <resource-bundle>messages.LslBundle</resource-bundle>

    <actions>
        <action id="io.github.koollsl.lsl.actions.LslCreateSourceFileAction"
                class="io.github.koollsl.lsl.actions.LslCreateSourceFileAction"
                text="LSL Source Script"
                description="Create a new LSL source file (.lslp)">
            <add-to-group group-id="NewGroup"
                    anchor="before"
                    relative-to-action="NewFile"/>
        </action>

        <action id="io.github.koollsl.lsl.actions.LslCreateModuleFileAction"
                class="io.github.koollsl.lsl.actions.LslCreateModuleFileAction"
                text="LSL Module Script"
                description="Create a new LSL module file (.lslm)">
            <add-to-group group-id="NewGroup"
                    anchor="after"
                    relative-to-action="io.github.koollsl.lsl.actions.LslCreateSourceFileAction"/>
        </action>

        <!-- Action 1: Open in new/focused Tab -->
        <action id="Lsl.OpenProcessedFile"
                class="io.github.koollsl.lsl.actions.OpenProcessedLslAction"
                text="Open Processed File (.lsl)"
                description="Opens the corresponding .lsl file"
                icon="AllIcons.Actions.Preview">
        </action>

        <!-- Tab Right-Click Menu -->
        <group id="Lsl.ProcessedFileGroup"
                text="LSL Preprocessor"
                popup="false">
            <add-to-group group-id="EditorTabPopupMenu"
                    anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu"
                    anchor="first"/>

            <reference ref="Lsl.OpenProcessedFile"/>
            <separator/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Project Services -->
        <projectService serviceImplementation="io.github.koollsl.lsl.preprocessor.LslPreprocessorEngine"/>

        <!-- LSL Language Definitions & Syntax -->
        <fileType
                name="LSL file"
                implementationClass="LslFileType"
                fieldName="INSTANCE"
                language="LSL"
                extensions="lslp;lslm;lsl"/>

        <!-- unpack secondlife.d.luau in the background on startup-->
        <postStartupActivity implementation="io.github.koollsl.lsl.slua.SluaDefinitionInitializer"/>

        <!-- Suggest Luau plugin if none is installed -->
        <editorNotificationProvider
                implementation="io.github.koollsl.lsl.slua.SluaEditorNotificationProvider"/>

        <!-- Code Vision Providers -->
        <codeInsight.daemonBoundCodeVisionProvider
                implementation="io.github.koollsl.lsl.references.LslFunctionUsageCodeVisionProvider"/>
        <config.codeVisionGroupSettingProvider
                implementation="io.github.koollsl.lsl.references.LslCodeVisionGroupSettingProvider"/>

        <editorNotificationProvider
                implementation="io.github.koollsl.lsl.safeguards.LslBuildOutputNotificationProvider"/>
        <writingAccessProvider
                implementation="io.github.koollsl.lsl.safeguards.LslBuildOutputWritingAccessProvider"/>
        <lang.parserDefinition
                language="LSL"
                implementationClass="io.github.koollsl.lsl.parser.LslParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslSyntaxHighlighterFactory"/>
        <lang.commenter
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslCommenter"/>
        <lang.braceMatcher
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslPairedBraceMatcher"/>
        <lang.psiStructureViewFactory
                language="LSL"
                implementationClass="io.github.koollsl.lsl.structure.LslStructureViewFactory"/>
        <navbar
                implementation="io.github.koollsl.lsl.structure.LslStructureAwareNavBar"/>
        <lang.quoteHandler
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslQuoteHandler"/>
        <lang.documentationProvider
                language="LSL"
                implementationClass="io.github.koollsl.lsl.documentation.LslDocumentationProvider"/>
        <completion.contributor
                language="LSL"
                implementationClass="io.github.koollsl.lsl.completion.LslCompletionContributor"/>

        <langCodeStyleSettingsProvider
                implementation="io.github.koollsl.lsl.formatting.LslLanguageCodeStyleSettingsProvider"/>

        <lang.foldingBuilder
                language="LSL"
                implementationClass="io.github.koollsl.lsl.structure.LslFoldingBuilder"/>
        <lang.findUsagesProvider
                language="LSL"
                implementationClass="io.github.koollsl.lsl.structure.LslFindUsagesProvider"/>
        <spellchecker.support
                language="LSL"
                implementationClass="io.github.koollsl.lsl.formatting.LslSpellcheckingStrategy"/>
        <lang.namesValidator
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslNamesValidator"/>

        <lang.formatter
                language="LSL"
                implementationClass="io.github.koollsl.lsl.formatting.LslFormattingModelBuilder"/>
        <psi.referenceContributor
                language="LSL"
                implementation="io.github.koollsl.lsl.references.LslReferenceContributor"/>

        <highlightErrorFilter
                implementation="io.github.koollsl.lsl.annotation.LslPreprocessorErrorFilter"/>
        <lang.inspectionSuppressor
                language="LSL"
                implementationClass="io.github.koollsl.lsl.annotation.LslDisabledCodeInspectionSuppressor"/>
        <annotator
                language="LSL"
                implementationClass="io.github.koollsl.lsl.annotation.LslDisabledCodeAnnotator"/>
        <annotator
                language="LSL"
                implementationClass="io.github.koollsl.lsl.annotation.LslAnnotator"/>
        <colorSettingsPage
                implementation="io.github.koollsl.lsl.syntax.LslColorSettingsPage"/>
        <iconProvider
                implementation="LslIconProvider"/>

        <projectViewNodeDecorator
                implementation="io.github.koollsl.lsl.psi.LslProjectViewNodeDecorator"/>

        <postStartupActivity implementation="io.github.koollsl.lsl.psi.LslStartupActivity"/>

        <applicationConfigurable
                parentId="language"
                instance="io.github.koollsl.lsl.shared.settings.LslSettingsConfigurable"
                id="settings.LslSettingsConfigurable"
                displayName="LSL"/>

        <internalFileTemplate name="LSL Source Script"/>
        <internalFileTemplate name="LSL Module Script"/>

        <!-- Inspections -->
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUnusedFunction"
                displayName="Unused function"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUnusedFunctionInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUnusedVariable"
                displayName="Unused variable"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUnusedVariableInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUnusedArgument"
                displayName="Unused argument"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUnusedArgumentInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUnusedState"
                displayName="Unused state"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUnusedStateInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUnusedLabel"
                displayName="Unused label"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUnusedLabelInspection"/>

        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUndeclaredFunction"
                displayName="Undeclared function"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUndeclaredFunctionInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUndeclaredVariable"
                displayName="Undeclared variable"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUndeclaredVariableInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUndeclaredState"
                displayName="Undeclared state"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUndeclaredStateInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUndeclaredLabel"
                displayName="Undeclared label"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUndeclaredLabelInspection"/>

        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslReservedIdentifier"
                displayName="Reserved identifier"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslReservedIdentifierInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslRedeclaredIdentifier"
                displayName="Redeclared identifier"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslRedeclaredIdentifierInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslInvalidVectorOrQuaternionItem"
                displayName="Invalid vector or quaternion item"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslInvalidVectorOrQuaternionItemInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslEmptyStateBody"
                displayName="Empty state"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslEmptyStateBodyInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUnreachableCode"
                displayName="Unreachable code"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUnreachableCodeInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslRedundantTypeCast"
                displayName="Redundant type cast"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslRedundantTypeCastInspection"/>

        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslInvalidAssignmentType"
                displayName="Invalid assignment type"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslInvalidAssignmentTypeInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslInvalidReturnType"
                displayName="Invalid return type"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslInvalidReturnTypeInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslInvalidExpressionType"
                displayName="Invalid expression type"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslInvalidExpressionTypeInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslInvalidFunctionCallArgument"
                displayName="Invalid function call argument"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslInvalidFunctionCallArgumentInspection"/>

        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslInvalidEventDeclaration"
                displayName="Invalid event declaration"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslInvalidEventDeclarationInspection"/>
        <localInspection
                language="LSL"
                groupName="LSL"
                shortName="LslUnmatchedDirective"
                displayName="Unmatched or unclosed #directive"
                enabledByDefault="true"
                implementationClass="io.github.koollsl.lsl.inspections.LslUnmatchedDirectiveInspection"
                level="ERROR"/>
    </extensions>


</idea-plugin>